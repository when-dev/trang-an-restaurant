# Public URL of the deployment (used for canonical URLs, sitemap, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://trang-an-demo.vercel.app

# demo         (default) public preview before approval: one slim "unofficial proposal" line, noindex
# presentation local client presentation (put it in .env.local): no notice, noindex
# official     ONLY after the owner approved (OWNER_APPROVAL_CHECKLIST.md): © line, indexable
NEXT_PUBLIC_SITE_MODE=demo

# Optional: Google Places API (New) key for live rating + up to 5 reviews on /reviews.
# Server-side only — never prefix with NEXT_PUBLIC_. Restrict the key to "Places API (New)".
GOOGLE_PLACES_API_KEY=
